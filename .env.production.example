# Production Environment Variables
# Copy this file to .env.production and fill in your values

# JWT Secret (generate a strong random string)
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production

# Recommendation Service API Key (generate a strong random string)
RECOMMENDATION_API_KEY=your-recommendation-api-key-change-this-in-production

# SkillBridge AI Tutor (backend only; never expose GEMINI_API_KEY through VITE_*)
AI_TUTOR_ENABLED=false
GEMINI_API_KEY=your-google-gemini-api-key
GEMINI_MODEL=gemini-3.5-flash-lite
AI_TUTOR_DAILY_USER_LIMIT=10
AI_TUTOR_DAILY_GLOBAL_LIMIT=100
AI_TUTOR_MAX_INPUT_CHARS=4000
AI_TUTOR_MAX_OUTPUT_TOKENS=1024
AI_TUTOR_REQUEST_TIMEOUT_MS=60000
AI_TUTOR_PROVIDER_ATTEMPTS=2
AI_TUTOR_RETRY_DELAY_MS=350
AI_TUTOR_MAX_CONVERSATION_TURNS=50
AI_TUTOR_MAX_CONTEXT_CHARS=12000
AI_TUTOR_MAX_CONTEXT_MESSAGES=24
AI_TUTOR_DOCUMENT_RAG_ENABLED=false
AI_TUTOR_DOCUMENT_MAX_FILE_BYTES=5242880
AI_TUTOR_DOCUMENT_MAX_PAGES=50
AI_TUTOR_DOCUMENT_MAX_CHARACTERS=150000
AI_TUTOR_DOCUMENT_MAX_CHUNKS=400
AI_TUTOR_DOCUMENT_MAX_ACTIVE_PER_USER=5
AI_TUTOR_DOCUMENT_DAILY_UPLOAD_ATTEMPTS=10
AI_TUTOR_DOCUMENT_GLOBAL_DAILY_EMBEDDING_CHARACTERS=1000000
AI_TUTOR_DOCUMENT_GLOBAL_PROCESSING_CONCURRENCY=2
AI_TUTOR_DOCUMENT_PARSE_TIMEOUT_MS=20000
AI_TUTOR_DOCUMENT_EMBEDDING_TIMEOUT_MS=30000
AI_TUTOR_DOCUMENT_EMBEDDING_MODEL=gemini-embedding-001
AI_TUTOR_DOCUMENT_EMBEDDING_DIMENSIONS=768
AI_TUTOR_DOCUMENT_EMBEDDING_VERSION=gemini-embedding-001:768:v1
AI_TUTOR_DOCUMENT_RETRIEVAL_CHUNKS=5
AI_TUTOR_DOCUMENT_RETRIEVAL_MIN_SCORE=0.3
AI_TUTOR_DOCUMENT_MAX_CONTEXT_CHARS=14000

# Allowed Origins for CORS
ALLOWED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# Cloudinary Configuration
CLOUDINARY_CLOUD_NAME=your-cloudinary-cloud-name
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret

# Email Configuration (e.g., Gmail, SendGrid)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-email-app-password

# Frontend API URL
VITE_API_URL=https://api.yourdomain.com

# Optional: MongoDB credentials for production
# MONGODB_USERNAME=skillbridge
# MONGODB_PASSWORD=your-secure-mongodb-password
# MONGODB_URI=mongodb://skillbridge:your-secure-mongodb-password@mongodb:27017/skillbridge?authSource=admin
