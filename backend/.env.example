# Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB Configuration
MONGODB_URI=mongodb://localhost:27017/skillbridge
# For MongoDB Atlas, use:
# MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/skillbridge?retryWrites=true&w=majority

# JWT Secret
JWT_SECRET=your_jwt_secret_key_here_change_in_production
JWT_EXPIRE=7d

# CORS Configuration
FRONTEND_URL=http://localhost:5173

# Safepay Payments
SAFEPAY_ENV=sandbox
SAFEPAY_API_KEY=
# The dashboard's single "shared secret" under Endpoints - used for both of
# these, they're confirmed to be the same value.
SAFEPAY_V1_SECRET=
SAFEPAY_WEBHOOK_SECRET=

# Recommendation Service (use 127.0.0.1, not localhost - on some machines Node
# resolves "localhost" to the IPv6 ::1 loopback, but uvicorn only binds IPv4,
# which causes ECONNREFUSED even though the service is actually running)
RECOMMENDATION_SERVICE_URL=http://127.0.0.1:8001
RECOMMENDATION_SERVICE_API_KEY=your-secret-api-key-here

# JaaS (Jitsi as a Service, 8x8) - video calling
# JAAS_PRIVATE_KEY_BASE64: base64-encode the ENTIRE downloaded .pem file (armor,
# newlines and all) and paste the result here as one line - a raw PEM has literal
# newlines that don't survive .env, and base64 sidesteps that entirely.
#   e.g. (bash):  base64 -w0 private.pem
# Sanity check: the base64 string's length must be a multiple of 4 (or padded with
# '=' to reach one) - losing a character during copy-paste is easy to miss and
# fails signing with a cryptic "unsupported" decoder error, not an obvious one.
JAAS_APP_ID=
JAAS_PRIVATE_KEY_BASE64=
JAAS_API_KEY_ID=

# OAuth — identity is verified server-side against these.
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
# Facebook login stays disabled until BOTH of these are set.
FACEBOOK_APP_ID=your_facebook_app_id
FACEBOOK_APP_SECRET=your_facebook_app_secret

# Safepay V2 (Express Checkout, @sfpy/node-core)
# Merchant secret used to authenticate the SDK (x-sfpy-merchant-secret header).
# Falls back to SAFEPAY_WEBHOOK_SECRET if unset.
SAFEPAY_SECRET_KEY=
#
# Going live: set SAFEPAY_ENV=production above and replace the three secrets
# with the LIVE merchant's values. Nothing else in the code needs changing -
# both the API host (api.getsafepay.com) and the checkout host
# (getsafepay.com/embedded) switch off SAFEPAY_ENV on their own.
#
# Also required in production: FRONTEND_URL must be the public site. The app
# refuses to build a checkout if it is missing or still localhost, because the
# buyer would be redirected to their own machine after paying.
#
# Payment intent. Confirmed in SANDBOX that this merchant only accepts
# CYBERSOURCE ('PAYMENT' is rejected). Whether the LIVE account uses the same
# depends on how Safepay routes it - ask them, then set it here rather than
# editing code.
SAFEPAY_INTENT=CYBERSOURCE

# Mail identities. Transactional/account email goes out as SUPPORT_EMAIL;
# the public contact form uses INFO_EMAIL. Both must be addresses the SMTP
# account is allowed to send as.
SUPPORT_EMAIL=support@skill-bridge.me
INFO_EMAIL=info@skill-bridge.me

# Render's free plan blocks outbound SMTP, so a host that works locally times
# out there. Set this and mail goes over Resend's HTTPS API instead; leave it
# empty and SMTP above is used. The sending domain must be verified in Resend.
RESEND_API_KEY=

# Sending identity for the contact and support forms. Set it to something like
# noreply@yourdomain so those messages don't arrive From the same mailbox they
# are delivered To - that files them as sent-by-you in the inbox. Needs no
# mailbox, only an address on a verified sending domain. Leave empty to send
# as SUPPORT_EMAIL/INFO_EMAIL.
MAIL_FROM=
