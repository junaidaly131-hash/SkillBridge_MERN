# MongoDB Configuration
MONGODB_URI=mongodb+srv://username:password@cluster.xxxxx.mongodb.net/skillbridge?retryWrites=true&w=majority

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-min-32-characters

# Server Configuration
PORT=5000
NODE_ENV=production

# Recommendation Service
RECOMMENDATION_SERVICE_URL=https://your-recommendation-service.onrender.com
RECOMMENDATION_SERVICE_API_KEY=your-secret-api-key-change-in-production

# SkillBridge AI Tutor (Gemini key stays backend-only; never use VITE_*)
AI_TUTOR_ENABLED=false
GEMINI_API_KEY=your-google-gemini-api-key
GEMINI_MODEL=gemini-3.8-flash
AI_TUTOR_DAILY_USER_LIMIT=10
AI_TUTOR_DAILY_GLOBAL_LIMIT=100
AI_TUTOR_MAX_INPUT_CHARS=4000
AI_TUTOR_MAX_OUTPUT_TOKENS=1024
AI_TUTOR_REQUEST_TIMEOUT_MS=30000
AI_TUTOR_MAX_CONVERSATION_TURNS=50
AI_TUTOR_MAX_CONTEXT_CHARS=12000
AI_TUTOR_MAX_CONTEXT_MESSAGES=24

# Cloudinary Configuration
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# Email Configuration
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-email-app-password

# Frontend URL (for CORS)
FRONTEND_URL=https://your-project.vercel.app
