# MongoDB Configuration
MONGODB_URI=mongodb+srv://username:password@cluster.xxxxx.mongodb.net/skillbridge?retryWrites=true&w=majority

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-min-32-characters

# Server Configuration
PORT=5000
NODE_ENV=production

# Recommendation Service
RECOMMENDATION_SERVICE_URL=https://your-recommendation-service.onrender.com
RECOMMENDATION_SERVICE_API_KEY=your-secret-api-key-change-in-production

# SkillBridge AI Tutor (Gemini key stays backend-only; never use VITE_*)
AI_TUTOR_ENABLED=false
GEMINI_API_KEY=your-google-gemini-api-key
GEMINI_MODEL=gemini-3.5-flash-lite
AI_TUTOR_DAILY_USER_LIMIT=10
AI_TUTOR_DAILY_GLOBAL_LIMIT=100
AI_TUTOR_MAX_INPUT_CHARS=4000
AI_TUTOR_MAX_OUTPUT_TOKENS=1024
AI_TUTOR_REQUEST_TIMEOUT_MS=60000
AI_TUTOR_PROVIDER_ATTEMPTS=2
AI_TUTOR_RETRY_DELAY_MS=350
AI_TUTOR_MAX_CONVERSATION_TURNS=50
AI_TUTOR_MAX_CONTEXT_CHARS=12000
AI_TUTOR_MAX_CONTEXT_MESSAGES=24
AI_TUTOR_DOCUMENT_RAG_ENABLED=false
AI_TUTOR_DOCUMENT_MAX_FILE_BYTES=5242880
AI_TUTOR_DOCUMENT_MAX_PAGES=50
AI_TUTOR_DOCUMENT_MAX_CHARACTERS=150000
AI_TUTOR_DOCUMENT_MAX_CHUNKS=400
AI_TUTOR_DOCUMENT_MAX_ACTIVE_PER_USER=5
AI_TUTOR_DOCUMENT_DAILY_UPLOAD_ATTEMPTS=10
AI_TUTOR_DOCUMENT_GLOBAL_DAILY_EMBEDDING_CHARACTERS=1000000
AI_TUTOR_DOCUMENT_GLOBAL_PROCESSING_CONCURRENCY=2
AI_TUTOR_DOCUMENT_PARSE_TIMEOUT_MS=20000
AI_TUTOR_DOCUMENT_EMBEDDING_TIMEOUT_MS=30000
AI_TUTOR_DOCUMENT_EMBEDDING_MODEL=gemini-embedding-001
AI_TUTOR_DOCUMENT_EMBEDDING_DIMENSIONS=768
AI_TUTOR_DOCUMENT_EMBEDDING_VERSION=gemini-embedding-001:768:v1
AI_TUTOR_DOCUMENT_RETRIEVAL_CHUNKS=5
AI_TUTOR_DOCUMENT_RETRIEVAL_MIN_SCORE=0.3
AI_TUTOR_DOCUMENT_MAX_CONTEXT_CHARS=14000
AI_TUTOR_STUDY_TOOLS_ENABLED=false
AI_TUTOR_STUDY_SUMMARY_DIRECT_CONTEXT_CHARS=40000
AI_TUTOR_STUDY_SUMMARY_SECTION_CONTEXT_CHARS=28000
AI_TUTOR_STUDY_QUIZ_CONTEXT_CHARS=30000
AI_TUTOR_STUDY_QUIZ_MAX_EVIDENCE_CHUNKS=12
AI_TUTOR_STUDY_MAX_PROVIDER_CALLS_PER_ACTION=4
AI_TUTOR_STUDY_MAX_INTERMEDIATE_CHARS=30000
AI_TUTOR_STUDY_SUMMARY_OUTPUT_TOKENS=2048
AI_TUTOR_STUDY_QUIZ_OUTPUT_TOKENS=4096
AI_TUTOR_STUDY_MAX_OUTPUT_CHARS=60000
AI_TUTOR_STUDY_PROVIDER_TIMEOUT_MS=60000
AI_TUTOR_STUDY_ACTION_TIMEOUT_MS=540000
AI_TUTOR_STUDY_GLOBAL_DAILY_PROVIDER_CALLS=200
AI_TUTOR_STUDY_GLOBAL_DAILY_INPUT_TOKENS=1000000
AI_TUTOR_STUDY_GLOBAL_DAILY_OUTPUT_TOKENS=500000

# Cloudinary Configuration
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# Email Configuration
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-email-app-password

# Frontend URL (for CORS)
FRONTEND_URL=https://your-project.vercel.app
